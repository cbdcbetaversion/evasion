rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(uid) {
      return isVerifiedUser() && request.auth.uid == uid;
    }

    function isValidGoogleAuthLink(data) {
      return data.keys().hasAll(['uid', 'evasionUserId', 'displayName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'evasionUserId', 'displayName', 'createdAt', 'updatedAt'])
        && data.uid is string
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.uid == request.auth.uid
        && data.evasionUserId is string
        && data.evasionUserId.size() >= 4
        && data.evasionUserId.size() <= 64
        && data.evasionUserId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 64
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isSyncProfileAction() {
      return incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
    }

    match /googleAuthLinks/{uid} {
      allow get: if isOwner(uid) && isValidId(uid);
      allow list: if false;

      allow create: if isOwner(uid)
        && isValidId(uid)
        && isValidGoogleAuthLink(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isOwner(uid)
        && isValidId(uid)
        && isValidGoogleAuthLink(incoming())
        && (
          isSyncProfileAction()
          && incoming().diff(existing()).affectedKeys().hasOnly(['evasionUserId', 'displayName', 'updatedAt'])
        );

      allow delete: if false;
    }
  }
}
