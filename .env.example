# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public base URL of the app (used for PayPal redirect URLs)
APP_URL="MY_APP_URL"

# --- Supabase Auth, Profiles & Storage ---
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
VITE_SUPABASE_STORAGE_BUCKET="evasion"

# --- Base de données PostgreSQL / Supabase (Vercel Production) ---
# Collez ici l'URI PostgreSQL Supabase (Transaction/Session Pooler : postgres://postgres.[ref]:[password]@aws-0-...pooler.supabase.com:6543/postgres)
# Ou connectez directement l'intégration Supabase dans Vercel (qui injecte POSTGRES_URL automatiquement).
DATABASE_URL="postgres://user:password@host:5432/evasion"
POSTGRES_URL="postgres://user:password@host:5432/evasion"

# Redis connection URI for multi-node WebSocket Pub/Sub fan-out (optionnel)
REDIS_URL="redis://default:password@host:6379"

# HMAC-SHA256 signing secret for HttpOnly multi-device session tokens
AUTH_SECRET="CHANGE_THIS_TO_A_64_HEX_CHARACTER_SECRET"

# S3 / Cloudflare R2 / GCS S3-compatible object storage + CDN for 1-min videos & photos
MEDIA_S3_ENDPOINT="https://s3.eu-west-3.amazonaws.com"
MEDIA_S3_BUCKET="evasion-media-prod"
MEDIA_S3_REGION="eu-west-3"
MEDIA_S3_ACCESS_KEY_ID="MY_S3_ACCESS_KEY"
MEDIA_S3_SECRET_ACCESS_KEY="MY_S3_SECRET_KEY"
MEDIA_CDN_URL="https://cdn.mon-domaine.com"

# --- Real Server-Verified Payments ---
# PayPal REST API & Webhook ID (signature verified via PayPal API)
PAYPAL_CLIENT_ID="MY_PAYPAL_CLIENT_ID"
PAYPAL_CLIENT_SECRET="MY_PAYPAL_CLIENT_SECRET"
PAYPAL_WEBHOOK_ID="MY_PAYPAL_WEBHOOK_ID"
